# Ignore everything by default


# But not these files:
!.gitignore

# Allow CSV files
!*.csv

# Allow Jupyter notebooks
!*.ipynb

# Allow Python files
!*.py

# Allow directories (so we can traverse into them)
!*/

# Ignore common large files even if they match above patterns
*.npy
*.db
*.xml
*.h5
*.hdf5

# Ignore model checkpoints and weights
*.pth
*.pt
*.ckpt
*.safetensors

# Ignore image outputs
*.png
*.jpg
*.jpeg
*.gif
*.svg

# Ignore compressed files
*.zip
*.tar
*.gz
*.rar

# Ignore Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Ignore Jupyter checkpoints
.ipynb_checkpoints/

# Ignore environment files
.env
.venv
env/
venv/
ENV/

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# ---- production webapp + docs (re-allow web assets and prediction data) ----
# These must be tracked so the static GitHub Pages site can be deployed.
!*.html
!*.css
!*.js
!*.json
!*.md
!*.txt
!*.toml
!*.lock
!*.yml
!*.yaml

# Still keep large/regenerable training artifacts out of git
production/artifacts/
production/**/__pycache__/
production/*.log